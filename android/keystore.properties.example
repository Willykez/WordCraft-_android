# Copy this file to keystore.properties (same folder) and fill in real values.
# keystore.properties is in .gitignore — it, and the .jks/.keystore file it points to,
# must never be committed. In CI, skip this file entirely and set the WORDCRAFT_KEYSTORE_FILE,
# WORDCRAFT_KEYSTORE_PASSWORD, WORDCRAFT_KEY_ALIAS and WORDCRAFT_KEY_PASSWORD env vars instead
# (build.gradle.kts falls back to those when this file is absent).

# Path is resolved relative to the android/ folder (this file's folder).
storeFile=release.jks
storePassword=changeit
keyAlias=wordcraft
keyPassword=changeit
